# Kubernetes
K8S_IN_CLUSTER=false
K8S_CLUSTER_NAME=default-cluster
K8S_METRICS_POLL_INTERVAL_SECONDS=15

# TimescaleDB (PostgreSQL)
TIMESCALE_DSN=postgresql://tsdbadmin:password@localhost:5432/tsdb?sslmode=require

# TypeSafe AI (Jev)
TYPESAFE_API_KEY=your-typesafe-api-key
JEV_ENABLED=true

# OpenTelemetry
OTEL_SERVICE_NAME=k8s-advisor
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENABLED=true

# Advisor API
API_HOST=0.0.0.0
API_PORT=8080
